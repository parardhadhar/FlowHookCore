{
  "name": "flowhook-api",
  "version": "1.0.0",
  "description": "FlowHook webhook automation engine API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "tsc && node scripts/copy-schema.cjs",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:init": "node -r ts-node/register src/db/migrate.ts",
    "test": "node -r ts-node/register --test tests/signatures.test.ts",
    "demo": "node scripts/demo.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bullmq": "^6.3.9",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
